{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ProfFoundCredentialMetadata",
  "description": "Standard off-chain JSON schema for verifiable credentials in the ProfFound protocol.",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "The title or credential type (e.g. Junior Solidity Developer)"
    },
    "description": {
      "type": "string",
      "description": "Detailed explanation of the competency, achievement, or qualification"
    },
    "issuer": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "address": { "type": "string", "pattern": "^0x[a-fA-F0-9]{40}$" },
        "website": { "type": "string", "format": "uri" }
      },
      "required": ["name", "address"]
    },
    "recipient": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "address": { "type": "string", "pattern": "^0x[a-fA-F0-9]{40}$" }
      },
      "required": ["address"]
    },
    "skills": {
      "type": "array",
      "items": { "type": "string" },
      "description": "List of validated technical skills"
    },
    "evidenceUrl": {
      "type": "string",
      "format": "uri",
      "description": "URL to raw certificate artifact, GitHub commit, or project deployment"
    },
    "issuedAt": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 issuance timestamp"
    }
  },
  "required": ["title", "issuer", "recipient", "issuedAt"]
}
